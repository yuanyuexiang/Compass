# 复制为 .env 使用；backend 进程从项目根或 backend/ 目录读取
DATABASE_URL=postgresql+psycopg://compass:compass@localhost:5432/compass
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=compass
MINIO_SECRET_KEY=compass-secret

# 采集默认关闭 SSL 校验（政府/公共资源站证书链常配错，放宽采集）；需强校验时置 true
# CRAWLER_VERIFY_SSL=true

# LLM 供应商密钥与场景模型统一在平台「模型服务」中配置。
# Embedding（M2 启用）：SiliconFlow bge-m3
SILICONFLOW_API_KEY=
# 秘塔 AI 搜索：供「AI 生成画像」联网检索企业信息；未配则该功能降级（其余不受影响）
METASO_API_KEY=
